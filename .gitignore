# Environment
.venv/
.venv-linux/
.venv-macos/
# Local model binaries: pinned Whisper (~1.6 GB) and optional voice (~340 MB).
models/
__pycache__/
*.pyc
.pytest_cache/

# Session recordings: transcripts of real private conversations (interviews,
# calls). They stay local by default -- delete these two lines if you decide
# you want history backed up to the private repo.
logs/
*.jsonl
# Cross-process config transaction locks are local runtime state.
.*.ambientqa.lock
